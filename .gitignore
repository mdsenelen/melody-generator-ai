# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.env
.env.local
.env.*.local
.venv/
venv/

# Node
node_modules/

# Project-specific
backend/venv/
frontend/node_modules/
backend/resampy/

# Unrelated tooling artifacts (accidentally committed)
.sfdx/

# Runtime-generated data (uploads, generated audio/MIDI, session logs)
backend/data/recordings/
backend/data/generated/
backend/data/logs/

# Async transcription job workflow local dev state (SQLite job store, local
# object-storage fallback) -- see CLAUDE.md's "Async Transcription Job
# Workflow" section. Not used at all when DATABASE_URL/JOB_STORAGE_BUCKET
# are set (production).
backend/data/jobs.db
backend/data/jobs.db-wal
backend/data/jobs.db-shm
backend/data/job_storage/

# Model checkpoints — large binaries, not source-controlled (see CLAUDE.md
# for the expected checkpoint schema)
backend/app/model/weights/*.pth

# Frontend build artefacts
frontend/.next/
frontend/tsconfig.tsbuildinfo

# Logs
*.log
*.err

# Large media assets — serve from CDN/object storage instead.
# Note: frontend/public/background.mp4 and backend/app/soundfonts/GeneralUser-GS.sf2
# are still tracked despite matching these patterns (ignore rules don't retroactively
# untrack) because both are live production assets — see docs/BASELINE.md.
frontend/public/*.mp4
*.sf2


.DS_Store
