PYTHONPATH=.

# Async transcription job workflow (see CLAUDE.md's "Async Transcription Job
# Workflow" section). All optional -- omitting every one of these gives a
# fully working local setup: SQLite for job metadata, an in-process queue,
# local disk for job input audio, and the worker running on a background
# thread inside this same process.
#
# RUN_WORKER_IN_PROCESS=false          # set false on the WEB service in production; the worker runs as its own `python -m app.worker_main` service instead
# DATABASE_URL=postgresql://user:pass@host:5432/dbname   # Postgres job metadata store (production)
# JOB_DB_PATH=./data/jobs.db           # SQLite path override (dev only; ignored if DATABASE_URL is set)
# REDIS_URL=redis://user:pass@host:6379/0   # Redis job queue (production)
# JOB_STORAGE_BUCKET=my-bucket         # S3/R2 bucket for job input audio (production)
# JOB_STORAGE_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com   # only for R2 / non-AWS S3-compatible storage
# JOB_STORAGE_REGION=auto
# JOB_STORAGE_ACCESS_KEY_ID=...
# JOB_STORAGE_SECRET_ACCESS_KEY=...
