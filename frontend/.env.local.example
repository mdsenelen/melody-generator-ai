# Used server-side by Next.js API route proxies.
BACKEND_BASE_URL=http://127.0.0.1:8000

# Used client-side: the browser uploads audio directly to this URL (bypassing
# the Next.js proxy, which is subject to Vercel's ~4.5MB body limit). In
# production this must be a publicly reachable backend URL, and the backend's
# CORS_ALLOWED_ORIGINS must include this app's deployed origin.
NEXT_PUBLIC_BACKEND_URL=http://127.0.0.1:8000
